# Diese Werte trägst du in Vercel unter Settings → Environment Variables ein (nicht hier speichern!)
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_ANON_KEY=eyJ... (Supabase: Project Settings → API → anon public)
SUPABASE_SERVICE_ROLE_KEY=eyJ... (Supabase: Project Settings → API → service_role, GEHEIM)
TWELVEDATA_API_KEY=...
FMP_API_KEY=...
PARALLEL_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...
OWNER_EMAIL=deine@email.de
HEALTH_SECRET=ein-langes-zufallswort (für /api/health?ping=1&secret=...)
# optional
AI_DAILY_LIMIT=60
MODEL_QUICK=claude-haiku-5-5
MODEL_DEFAULT=claude-sonnet-5-5
